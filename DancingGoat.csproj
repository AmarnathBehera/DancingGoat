<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RootNamespace>DancingGoat</RootNamespace>
    <UserSecretsId>79c858af-5444-4954-8d08-6592a961e82a</UserSecretsId>
    <SeparatedAdmin Condition="'$(SeparatedAdmin)' == ''">false</SeparatedAdmin>
    <NoWarn>$(NoWarn);KXE0004;KXE0006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Admin\SQLBrowser\**" />
    <Content Remove="Admin\SQLBrowser\**" />
    <EmbeddedResource Remove="Admin\SQLBrowser\**" />
    <None Remove="Admin\SQLBrowser\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Admin\ReportingApplication\UIPage\EditQuery.tsx" />
    <None Remove="App_Data\CMSModules\WebFarm\webfarm.sync" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="app_offline.htm_" Condition="Exists('app_offline.htm_')" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Exclude administration parts from the compilation in live-site only deployment  -->
  <ItemGroup Condition="'$(SeparatedAdmin)' == 'true'">
    <Compile Remove="AdminComponents\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SeparatedAdmin)' == 'true'">
    <DefineConstants>$(DefineConstants);SEPARATED_ADMIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="kentico.xperience.admin" Version="31.7.0" Condition="'$(SeparatedAdmin)' == 'false'" />
    <PackageReference Include="kentico.xperience.azurestorage" Version="31.7.0" />
    <PackageReference Include="kentico.xperience.cloud" Version="31.7.0" />
    <PackageReference Include="kentico.xperience.imageprocessing" Version="31.7.0" />
    <PackageReference Include="kentico.xperience.mjml" Version="31.7.0" />
    <PackageReference Include="kentico.xperience.webapp" Version="31.7.0" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.78.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="XperienceCommunity.SqlBrowser" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <TypeScriptCompile Include="Admin\ReportingApplication\UIPage\EditQuery.tsx" />
  </ItemGroup>
</Project>